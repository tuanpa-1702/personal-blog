PORT=3000
HOST=127.0.0.1

# Chuỗi ngẫu nhiên >= 32 ký tự: openssl rand -hex 32 (bắt buộc)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Tài khoản admin đầu tiên (seed khi DB chưa có admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Google OAuth (tùy chọn, để trống thì tắt)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain.com/api/auth/google/callback

# SMTP gửi email (tùy chọn)
SMTP_USER=
SMTP_APP_PASSWORD=

SITE_URL=https://your-domain.com
